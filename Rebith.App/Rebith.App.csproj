<Project Sdk="Microsoft.NET.Sdk">
  <!-- Ventana de Rebith (WinForms, .NET Framework 4.8: ya viene en Windows 10/11). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>Rebith.App</RootNamespace>
    <AssemblyName>Rebith</AssemblyName>
    <Version>2.0.0</Version>
    <Product>Rebith - Gestor de respaldos</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Deterministic>true</Deterministic>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Rebith.Core\Rebith.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="App.config" />
  </ItemGroup>
</Project>
