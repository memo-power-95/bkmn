<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pruebas del motor. Compila el mismo codigo de Rebith.Core para poder correrlo
       en cualquier equipo con el SDK de .NET (dotnet run). No se instala en la linea. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Rebith.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Rebith.Core\*.cs" Link="Core\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
