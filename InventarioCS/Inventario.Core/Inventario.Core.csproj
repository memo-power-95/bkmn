<Project Sdk="Microsoft.NET.Sdk">
  <!-- Motor del inventario por racks: sin dependencias externas, solo .NET Framework 4.8
       y winsqlite3.dll (ya viene en Windows 10/11). -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>Inventario.Core</RootNamespace>
    <AssemblyName>Inventario.Core</AssemblyName>
    <Version>1.0.0</Version>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.IO.Compression" />
  </ItemGroup>
</Project>
